<div class="games-page">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
      <h1 class="mb-1">Games</h1>
      <p class="text-secondary mb-0">
        Search and browse available Steam game keys.
      </p>
    </div>
  </div>

<div class="search-panel mb-4">
  <%= form_with url: games_path,
                method: :get,
                local: true,
                class: "row g-3 align-items-end" do |form| %>

    <div class="col-12 col-md-5">
      <%= form.label :query,
                     "Search Games",
                     class: "form-label" %>

      <%= form.text_field :query,
                          value: params[:query],
                          placeholder: "Search by title or description...",
                          class: "form-control" %>
    </div>

    <div class="col-12 col-md-4">
      <%= form.label :category_id,
                     "Category",
                     class: "form-label" %>

      <%= form.collection_select(
            :category_id,
            @categories,
            :id,
            :name,
            {
              selected: params[:category_id],
              include_blank: "All Categories"
            },
            {
              class: "form-select"
            }
          ) %>
    </div>

    <div class="col-12 col-md-3 d-grid">
      <%= form.submit "Search",
                      class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if params[:query].present? || params[:category_id].present? %>
    <div class="mt-3">
      <%= link_to "Clear Search",
                  games_path,
                  class: "btn btn-outline-light btn-sm" %>
    </div>
  <% end %>
</div>
<div class="row g-4 mt-3">
  <% @games.each do |game| %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card galaxy-game-card h-100">

        <% if game.image.attached? %>
          <%= image_tag game.image.variant(
                resize_to_fill: [600, 340]
              ),
              class: "card-img-top game-card-image",
              alt: game.title %>

        <% elsif game.header_image_url.present? %>
          <%= image_tag game.header_image_url,
                        class: "card-img-top game-card-image",
                        alt: game.title %>
        <% end %>

        <div class="card-body d-flex flex-column">
          <h5 class="card-title">
            <%= game.title %>
          </h5>

          <% if game.category.present? %>
            <p class="text-info small mb-2">
              <%= game.category.name %>
            </p>
          <% end %>

          <p class="card-text">
            <%= truncate(game.description, length: 120) %>
          </p>

          <div class="mt-auto">
            <% if game.on_sale? %>
              <p class="mb-2">
                <span class="text-secondary text-decoration-line-through">
                  <%= number_to_currency(game.price) %>
                </span>

                <span class="text-success fw-bold ms-2">
                  <%= number_to_currency(game.current_price) %>
                </span>
              </p>
            <% else %>
              <p class="fw-bold mb-2">
                <%= number_to_currency(game.current_price) %>
              </p>
            <% end %>

            <div class="d-flex gap-2 flex-wrap">
              <%= link_to "View Game",
                          game_path(game),
                          class: "btn btn-primary" %>

              <% if user_signed_in? %>
                <%= button_to "Add to Cart",
                              cart_items_path(game_id: game.id),
                              method: :post,
                              class: "btn btn-outline-info" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>