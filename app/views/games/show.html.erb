<div class="game-show-wrapper">
  <div class="row g-4 align-items-start">

    <div class="col-12 col-lg-6">
      <div class="game-image-panel">
        <% if @game.image.attached? %>
          <%= image_tag @game.image.variant(
                resize_to_limit: [1000, 700]
              ),
              class: "img-fluid game-show-image",
              alt: @game.title %>

        <% elsif @game.header_image_url.present? %>
          <%= image_tag @game.header_image_url,
                        class: "img-fluid game-show-image",
                        alt: @game.title %>
        <% else %>
          <div class="game-image-placeholder">
            No image available
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="game-info-panel">

        <h1 class="mb-3"><%= @game.title %></h1>

        <% if @game.category.present? %>
          <p>
            <span class="badge text-bg-primary">
              <%= @game.category.name %>
            </span>
          </p>
        <% end %>

        <% if @game.genres.any? %>
          <p>
            <strong>Genres:</strong>
            <%= @game.genres.map(&:name).join(", ") %>
          </p>
        <% end %>

        <% if @game.developer.present? %>
          <p>
            <strong>Developer:</strong>
            <%= @game.developer %>
          </p>
        <% end %>

        <% if @game.publisher.present? %>
          <p>
            <strong>Publisher:</strong>
            <%= @game.publisher %>
          </p>
        <% end %>

        <% if @game.release_date.present? %>
          <p>
            <strong>Release Date:</strong>
            <%= @game.release_date.strftime("%B %-d, %Y") %>
          </p>
        <% end %>

        <hr>

        <div class="mb-4">
          <h4>Description</h4>
          <p><%= @game.description %></p>
        </div>

        <div class="game-price-box mb-4">
          <% if @game.on_sale? %>
            <p class="mb-1">
              <span class="text-secondary text-decoration-line-through">
                <%= number_to_currency(@game.price) %>
              </span>
            </p>

            <p class="fs-3 fw-bold text-success mb-0">
              <%= number_to_currency(@game.current_price) %>
            </p>
          <% else %>
            <p class="fs-3 fw-bold mb-0">
              <%= number_to_currency(@game.current_price) %>
            </p>
          <% end %>
        </div>

        <div class="d-flex gap-2 flex-wrap">
          <% if user_signed_in? %>
            <%= button_to "Add to Cart",
                          cart_items_path(game_id: @game.id),
                          method: :post,
                          class: "btn btn-primary btn-lg" %>
          <% else %>
            <%= link_to "Log in to Add to Cart",
                        new_user_session_path,
                        class: "btn btn-primary btn-lg" %>
          <% end %>

          <%= link_to "Back to Games",
                      games_path,
                      class: "btn btn-outline-light btn-lg" %>
        </div>
      </div>
    </div>

  </div>
</div>