<div class="order-show-page">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <h1 class="mb-1">Order Confirmation</h1>

      <p class="text-secondary mb-0">
        Order <%= @order.order_number %>
      </p>
    </div>

    <span class="badge rounded-pill text-bg-primary fs-6">
      <%= @order.status.humanize %>
    </span>
  </div>

  <div class="row g-4">

    <div class="col-12 col-lg-8">
      <div class="order-panel">
        <h2 class="h4 mb-3">Order Items</h2>

        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle">
            <thead>
              <tr>
                <th>Game</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Line Total</th>
              </tr>
            </thead>

            <tbody>
              <% @order.order_items.each do |item| %>
                <tr>
                  <td class="fw-bold">
                    <%= item.product_title %>
                  </td>

                  <td>
                    <%= number_to_currency(item.unit_price) %>
                  </td>

                  <td>
                    <%= item.quantity %>
                  </td>

                  <td class="text-info fw-bold">
                    <%= number_to_currency(item.line_total) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="order-panel mt-4">
        <h2 class="h4 mb-3">Billing Address</h2>

        <p class="mb-0">
          <%= @order.first_name %>
          <%= @order.last_name %><br>

          <%= @order.address_line_1 %><br>

          <% if @order.address_line_2.present? %>
            <%= @order.address_line_2 %><br>
          <% end %>

          <%= @order.city %>,
          <%= @order.province_name %><br>

          <%= @order.postal_code %><br>
          Canada
        </p>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="order-summary-panel">

        <h2 class="h4 mb-3">Invoice Totals</h2>

        <div class="order-total-row">
          <span>Subtotal</span>
          <strong><%= number_to_currency(@order.subtotal) %></strong>
        </div>

        <% if @order.gst_amount.positive? %>
          <div class="order-total-row">
            <span>
              GST
              (<%= number_to_percentage(@order.gst_rate * 100, precision: 2) %>)
            </span>

            <strong>
              <%= number_to_currency(@order.gst_amount) %>
            </strong>
          </div>
        <% end %>

        <% if @order.pst_amount.positive? %>
          <div class="order-total-row">
            <span>
              PST
              (<%= number_to_percentage(@order.pst_rate * 100, precision: 2) %>)
            </span>

            <strong>
              <%= number_to_currency(@order.pst_amount) %>
            </strong>
          </div>
        <% end %>

        <% if @order.hst_amount.positive? %>
          <div class="order-total-row">
            <span>
              HST
              (<%= number_to_percentage(@order.hst_rate * 100, precision: 2) %>)
            </span>

            <strong>
              <%= number_to_currency(@order.hst_amount) %>
            </strong>
          </div>
        <% end %>

        <hr>

        <div class="order-total-row">
          <span>Tax Total</span>

          <strong>
            <%= number_to_currency(@order.tax_total) %>
          </strong>
        </div>

        <div class="order-grand-total mt-3">
          <span>Grand Total</span>

          <strong>
            <%= number_to_currency(@order.grand_total) %>
          </strong>
        </div>

        <div class="d-grid gap-2 mt-4">
          <%= link_to "View My Orders",
                      orders_path,
                      class: "btn btn-outline-info" %>

          <%= link_to "Continue Shopping",
                      games_path,
                      class: "btn btn-primary" %>
        </div>
      </div>
    </div>

  </div>
</div>