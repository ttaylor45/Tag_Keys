<div class="checkout-page">
  <div class="row g-4">

    <div class="col-12 col-lg-7">
      <div class="checkout-panel">
        <h1 class="mb-4">Checkout</h1>

        <h2 class="h4 mb-3">Billing Address</h2>

        <%= form_with url: checkout_path,
                      method: :post,
                      class: "checkout-form" do |form| %>

          <div class="row g-3">

            <div class="col-md-6">
              <%= form.label :first_name,
                             class: "form-label" %>

              <%= form.text_field :first_name,
                                  value: current_user.first_name,
                                  required: true,
                                  class: "form-control" %>
            </div>

            <div class="col-md-6">
              <%= form.label :last_name,
                             class: "form-label" %>

              <%= form.text_field :last_name,
                                  value: current_user.last_name,
                                  required: true,
                                  class: "form-control" %>
            </div>

            <div class="col-12">
              <%= form.label :address_line_1,
                             "Address",
                             class: "form-label" %>

              <%= form.text_field :address_line_1,
                                  value: current_user.address_line_1,
                                  required: true,
                                  class: "form-control" %>
            </div>

            <div class="col-12">
              <%= form.label :address_line_2,
                             "Apartment, suite, etc.",
                             class: "form-label" %>

              <%= form.text_field :address_line_2,
                                  value: current_user.address_line_2,
                                  class: "form-control" %>
            </div>

            <div class="col-md-5">
              <%= form.label :city,
                             class: "form-label" %>

              <%= form.text_field :city,
                                  value: current_user.city,
                                  required: true,
                                  class: "form-control" %>
            </div>

            <div class="col-md-4">
              <%= form.label :province_id,
                             "Province or Territory",
                             class: "form-label" %>

              <%= form.collection_select(
                    :province_id,
                    @provinces,
                    :id,
                    :name,
                    {
                      selected: current_user.province_id,
                      include_blank: "Select"
                    },
                    {
                      required: true,
                      class: "form-select"
                    }
                  ) %>
            </div>

            <div class="col-md-3">
              <%= form.label :postal_code,
                             class: "form-label" %>

              <%= form.text_field :postal_code,
                                  value: current_user.postal_code,
                                  required: true,
                                  class: "form-control" %>
            </div>

            <div class="col-12">
              <div class="form-check">
                <%= form.check_box :save_address,
                                   checked: true,
                                   class: "form-check-input" %>

                <%= form.label :save_address,
                               "Save this address to my account",
                               class: "form-check-label" %>
              </div>
            </div>

          </div>

          <div class="d-grid mt-4">
            <%= form.submit "Place Order",
                            class: "btn btn-primary btn-lg" %>
          </div>

        <% end %>
      </div>
    </div>

    <div class="col-12 col-lg-5">
      <div class="checkout-summary-panel">

        <h2 class="h4 mb-3">Order Summary</h2>

        <% @cart_items.each do |item| %>
          <div class="checkout-summary-item">

            <div>
              <strong><%= item.game.title %></strong>

              <div class="small text-secondary">
                Qty: <%= item.quantity %>
              </div>
            </div>

            <div class="text-info fw-bold">
              <%= number_to_currency(item.subtotal) %>
            </div>

          </div>
        <% end %>

        <hr>

        <div class="checkout-total-row">
          <span>Subtotal</span>

          <strong>
            <%= number_to_currency(@cart.subtotal) %>
          </strong>
        </div>

        <p class="small text-secondary mt-3 mb-0">
          GST, PST, or HST will be calculated using your selected
          province or territory when the order is placed.
        </p>

        <%= link_to "Back to Cart",
                    cart_path,
                    class: "btn btn-outline-light w-100 mt-4" %>
      </div>
    </div>

  </div>
</div>